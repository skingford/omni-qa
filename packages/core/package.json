{
  "name": "@omni-qa/core",
  "version": "1.0.0",
  "description": "omni-qa shared core runtime",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assertions/api-matchers": {
      "types": "./dist/assertions/api-matchers.d.ts",
      "default": "./dist/assertions/api-matchers.js"
    },
    "./config/loader": {
      "types": "./dist/config/loader.d.ts",
      "default": "./dist/config/loader.js"
    },
    "./config/types": {
      "types": "./dist/config/types.d.ts",
      "default": "./dist/config/types.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "default": "./dist/fixtures/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "default": "./dist/generator/index.js"
    },
    "./openapi/fetcher": {
      "types": "./dist/openapi/fetcher.d.ts",
      "default": "./dist/openapi/fetcher.js"
    },
    "./openapi/parser": {
      "types": "./dist/openapi/parser.d.ts",
      "default": "./dist/openapi/parser.js"
    },
    "./openapi/types": {
      "types": "./dist/openapi/types.d.ts",
      "default": "./dist/openapi/types.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./reporters/dingtalk": {
      "types": "./dist/reporters/dingtalk.d.ts",
      "default": "./dist/reporters/dingtalk.js"
    },
    "./reporters/email": {
      "types": "./dist/reporters/email.d.ts",
      "default": "./dist/reporters/email.js"
    },
    "./reporters/notifier.reporter": {
      "types": "./dist/reporters/notifier.reporter.d.ts",
      "default": "./dist/reporters/notifier.reporter.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/generator/templates && cp src/generator/templates/*.hbs dist/generator/templates/"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@playwright/test": "^1.58.2",
    "dotenv": "^17.3.1",
    "handlebars": "^4.7.8",
    "nodemailer": "^8.0.3",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "typescript": "^5.9.3"
  }
}
