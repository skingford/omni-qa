{
  "name": "omni-qa",
  "private": true,
  "version": "1.0.0",
  "description": "omni-qa - a universal API automation testing platform",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:config-studio && bun run build:cli",
    "build:cli": "bun run build:core && bun --filter @omni-qa/cli build",
    "build:core": "bun --filter @omni-qa/core build",
    "build:config-studio": "bun --filter @omni-qa/config-studio build",
    "dev": "bun run build:core && bun ./packages/cli/src/cli/index.ts",
    "dev:config-studio": "bun --filter @omni-qa/config-studio dev",
    "preview:config-studio": "bun --filter @omni-qa/config-studio preview",
    "test": "bun run build:core && bunx playwright test",
    "report": "bunx playwright show-report reports/html"
  },
  "devDependencies": {
    "@omni-qa/core": "workspace:*"
  }
}
